sii # Copia este archivo como .env.local y completa los valores

# Base de datos PostgreSQL (Neon o cualquier PostgreSQL)
DATABASE_URL="postgresql://usuario:password@host:5432/database?sslmode=require"

# NextAuth - Cambiar en producción
NEXTAUTH_SECRET="genera-un-secreto-seguro-aqui"
NEXTAUTH_URL="https://tu-dominio.com"

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary para almacenamiento de archivos
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
